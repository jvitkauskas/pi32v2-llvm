# RUN: llc -mtriple=pi32v2 -run-pass=postrapseudos -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=EXPAND
# RUN: llc -mtriple=pi32v2 -run-pass=postrapseudos,pi32v2-size-reduce -pi32v2-global-recolor=false -pi32v2-crossblock-recolor=false -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @return_value() { ret void }
  define void @fixed_copy() { ret void }
  define void @pair_copy() { ret void }
...
---
name: return_value
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2
    ; EXPAND-LABEL: name: return_value
    ; EXPAND: $r0 = MOV_RR killed renamable $r3
    ; CHECK-LABEL: name: return_value
    ; CHECK: renamable $r0 = ADD_F_RRR $r1, $r2
    ; CHECK-NEXT: PseudoRET $r0
    renamable $r3 = ADD_F_RRR $r1, $r2
    $r0 = COPY killed renamable $r3
    PseudoRET $r0, implicit $rets
...
---
name: fixed_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; EXPAND-LABEL: name: fixed_copy
    ; EXPAND: $r1 = MOV_RR killed $r0
    ; CHECK-LABEL: name: fixed_copy
    ; CHECK: $r1 = MOV_RR killed $r0
    $r1 = COPY killed $r0
    PseudoRET $r1, implicit $rets
...
---
name: pair_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1_r0
    ; EXPAND-LABEL: name: pair_copy
    ; EXPAND: renamable $r9_r8 = MOV_PAIR killed $r1_r0
    ; CHECK-LABEL: name: pair_copy
    ; CHECK: renamable $r9_r8 = MOV_PAIR killed $r1_r0
    renamable $r9_r8 = COPY killed $r1_r0
    PseudoRET $r9_r8, implicit $rets
...
