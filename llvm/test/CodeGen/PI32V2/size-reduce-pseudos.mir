# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -pi32v2-recolor-pseudos=false -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=DISABLED

--- |
  define void @select_constant() { ret void }
  define void @post_load() { ret void }
  define void @direct_spill() { ret void }
  define void @large_frame() { ret void }
...
---
name: select_constant
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0
    ; CHECK-LABEL: name: select_constant
    ; CHECK: renamable $r4 = LI_S16 255
    ; CHECK-NEXT: renamable $r4 = SELECT_CC_RII $r0, 0, 1, renamable $r4, 17
    ; DISABLED-LABEL: name: select_constant
    ; DISABLED: renamable $r8 = LI_S16 255
    renamable $r8 = LI_S16 255
    renamable $r8 = SELECT_CC_RII $r0, 0, 1, renamable $r8, 17
    GOTO_S %bb.1
  bb.1:
    liveins: $r0, $r8
    ST_W_L $r0, 0, killed renamable $r8
    PseudoRET implicit $rets
...
---
name: post_load
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0
    ; CHECK-LABEL: name: post_load
    ; CHECK: renamable $r4 = COPY $r0
    ; CHECK-NEXT: $r1, renamable $r4 = LDW_POST renamable $r4, 4
    ; DISABLED-LABEL: name: post_load
    ; DISABLED: renamable $r8 = COPY $r0
    renamable $r8 = COPY $r0
    $r1, renamable $r8 = LDW_POST renamable $r8, 4
    GOTO_S %bb.1
  bb.1:
    liveins: $r8
    $r0 = COPY killed renamable $r8
    PseudoRET $r0, implicit $rets
...
---
name: direct_spill
tracksRegLiveness: true
stack:
  - { id: 0, size: 4, alignment: 4 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0
    ; CHECK-LABEL: name: direct_spill
    ; CHECK: renamable $r4 = LDW_FI %stack.0, 0
    ; DISABLED-LABEL: name: direct_spill
    ; DISABLED: renamable $r8 = LDW_FI %stack.0, 0
    renamable $r8 = LDW_FI %stack.0, 0
    GOTO_S %bb.1
  bb.1:
    liveins: $r0, $r8
    ST_W_L $r0, 0, killed renamable $r8
    PseudoRET implicit $rets
...

# A large frame may need address materialization and register scavenging.
# Without a reliable expansion cost, exclude this register from global swaps.
---
name: large_frame
tracksRegLiveness: true
stack:
  - { id: 0, size: 8192, alignment: 4 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0
    ; CHECK-LABEL: name: large_frame
    ; CHECK: renamable $r8 = LDW_FI %stack.0, 0
    renamable $r8 = LDW_FI %stack.0, 0
    GOTO_S %bb.1
  bb.1:
    liveins: $r0, $r8
    ST_W_L $r0, 0, killed renamable $r8
    PseudoRET implicit $rets
...
