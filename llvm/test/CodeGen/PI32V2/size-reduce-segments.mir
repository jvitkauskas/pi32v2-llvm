# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -pi32v2-global-recolor=false -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -pi32v2-global-recolor=false -pi32v2-fine-recolor=false -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=DISABLED

--- |
  define void @independent_value() { ret void }
  define void @suffix_reuse() { ret void }
  define void @merged_fixed_value() { ret void }
  define void @interrupt_save_set() "interrupt" { ret void }
...

# The incoming r8 value is fixed. A later independent r8 definition and its
# loop uses can still be recolored. r1 becomes free before that definition.
---
name: independent_value
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r1, $r8
    ; CHECK-LABEL: name: independent_value
    ; CHECK: ST_W_L $r0, 0, killed $r8
    ; CHECK-NEXT: ST_W_L $r0, 4, killed $r1
    ; CHECK-NEXT: renamable $r1 = LI_S16 255
    ; DISABLED-LABEL: name: independent_value
    ; DISABLED: renamable $r8 = LI_S16 255
    ST_W_L $r0, 0, killed $r8
    ST_W_L $r0, 4, killed $r1
    renamable $r8 = LI_S16 255
    GOTO_S %bb.1
  bb.1:
    successors: %bb.1
    liveins: $r0, $r8
    ; CHECK: liveins: $r0, $r1
    ; CHECK: renamable $r1 = ADD_S14_RRI renamable $r1, 64
    ; CHECK-NEXT: ST_W_L $r0, 8, renamable $r1
    renamable $r8 = ADD_S14_RRI renamable $r8, 64, implicit-def dead $psr
    ST_W_L $r0, 8, renamable $r8
    GOTO_S %bb.1
...

# An unrelated r1 definition after the last use does not interfere with the
# connected value. Do not rename that independent definition or its uses.
---
name: suffix_reuse
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0
    ; CHECK-LABEL: name: suffix_reuse
    ; CHECK: renamable $r1 = LI_S16 255
    ; DISABLED-LABEL: name: suffix_reuse
    ; DISABLED: renamable $r8 = LI_S16 255
    dead $r8 = LI_S16 1000
    renamable $r8 = LI_S16 255
    GOTO_S %bb.1
  bb.1:
    liveins: $r0, $r8
    ; CHECK: liveins: $r0, $r1
    ; CHECK: ST_W_L $r0, 0, killed renamable $r1
    ; CHECK-NEXT: $r1 = LI_S16 1000
    ; CHECK-NEXT: ST_W_L $r0, 4, killed $r1
    ST_W_L $r0, 0, killed renamable $r8
    $r1 = LI_S16 1000
    ST_W_L $r0, 4, killed $r1
    PseudoRET implicit $rets
...

# Reaching definitions from both predecessors belong to one value region.
# A fixed definition on either path prevents renaming the merge's use.
---
name: merged_fixed_value
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0
    ; CHECK-LABEL: name: merged_fixed_value
    BEQ_RI $r0, 0, %bb.2
    GOTO_S %bb.1
  bb.1:
    successors: %bb.3
    liveins: $r0
    ; CHECK: renamable $r8 = LI_S16 255
    renamable $r8 = LI_S16 255
    GOTO_S %bb.3
  bb.2:
    successors: %bb.3
    liveins: $r0
    $r8 = LI_S16 1000
    GOTO_S %bb.3
  bb.3:
    liveins: $r0, $r8
    ; CHECK: liveins: $r0, $r8
    ; CHECK: ST_W_L $r0, 0, killed renamable $r8
    ST_W_L $r0, 0, killed renamable $r8
    PseudoRET implicit $rets
...

# An interrupt must preserve every GPR it modifies. A free caller-saved
# register is not a legal destination unless the prologue already saves it.
---
name: interrupt_save_set
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0
    ; CHECK-LABEL: name: interrupt_save_set
    ; CHECK: renamable $r8 = LI_S16 255
    renamable $r8 = LI_S16 255
    GOTO_S %bb.1
  bb.1:
    liveins: $r0, $r8
    ; CHECK: ST_W_L $r0, 0, killed renamable $r8
    ST_W_L $r0, 0, killed renamable $r8
    PseudoRET implicit $rets
...
