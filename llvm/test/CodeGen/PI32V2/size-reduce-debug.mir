# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -pi32v2-global-recolor=false -verify-machineinstrs %s -o - | FileCheck %s

# Debug locations inside a segment are renamed with their value. Locations
# inside and outside segments must not participate in physical liveness.
--- |
  define void @debug_segments() !dbg !4 { ret void }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "segments.c", directory: "/")
  !2 = !DISubroutineType(types: !{})
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "debug_segments", scope: !1, file: !1, line: 1, type: !2, spFlags: DISPFlagDefinition, unit: !0)
  !5 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !6 = !DILocalVariable(name: "value", scope: !4, file: !1, line: 1, type: !5)
  !7 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name: debug_segments
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r1, $r8
    ; CHECK-LABEL: name: debug_segments
    ST_W_L $r0, 0, killed $r8
    DBG_VALUE $r0, $noreg, !6, !DIExpression(), debug-location !7
    ST_W_L $r0, 4, killed $r1
    ; CHECK: renamable $r1 = LI_S16 255
    ; CHECK-NEXT: DBG_VALUE $r1, $noreg
    renamable $r8 = LI_S16 255
    DBG_VALUE $r8, $noreg, !6, !DIExpression(), debug-location !7
    GOTO_S %bb.1
  bb.1:
    liveins: $r0, $r8
    ; CHECK: ST_W_L $r0, 8, killed renamable $r1
    ; CHECK-NEXT: DBG_VALUE $r0, $noreg
    ST_W_L $r0, 8, killed renamable $r8
    DBG_VALUE $r0, $noreg, !6, !DIExpression(), debug-location !7
    PseudoRET implicit $rets
...
