# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -pi32v2-global-recolor=false -pi32v2-crossblock-recolor=false -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=pi32v2 -run-pass=pi32v2-size-reduce -pi32v2-global-recolor=false -pi32v2-crossblock-recolor=false -pi32v2-dying-source-recolor=false -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=DISABLED

--- |
  define void @dying_low() { ret void }
  define void @dying_high() { ret void }
  define void @still_live() { ret void }
  define void @early_clobber() { ret void }
...

# A dying input can also hold the result. This enables the short variable
# shift without changing the instruction count or extending any lifetime.
---
name: dying_low
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2
    ; CHECK-LABEL: name: dying_low
    ; CHECK: renamable $r0 = LSL_RRR killed $r0, $r1
    ; CHECK-NEXT: ST_W_L $r2, 0, killed renamable $r0
    ; DISABLED-LABEL: name: dying_low
    ; DISABLED: renamable $r3 = LSL_RRR killed $r0, $r1
    renamable $r8 = LSL_RRR killed $r0, $r1, implicit-def dead $psr
    ST_W_L $r2, 0, killed renamable $r8
    PseudoRET implicit $rets
...

# += can use a high input too. Keep the saved register count unchanged.
---
name: dying_high
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r8
    ; CHECK-LABEL: name: dying_high
    ; CHECK: renamable $r8 = ADD_RRR_L killed $r8, $r1
    ; DISABLED-LABEL: name: dying_high
    ; DISABLED: renamable $r0 = ADD_RRR_L killed $r8, $r1
    renamable $r0 = ADD_RRR_L killed $r8, $r1, implicit-def dead $psr
    ST_W_SP_L 0, killed renamable $r0, implicit $sp
    ST_W_L $r2, 4, $r1
    ST_W_L $r2, 8, $r3
    PseudoRET implicit $rets
...

# The input remains needed afterwards, so overwriting it is illegal.
---
name: still_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2
    ; CHECK-LABEL: name: still_live
    ; CHECK-NOT: renamable $r0 = LSL_RRR
    renamable $r8 = LSL_RRR $r0, $r1, implicit-def dead $psr
    ST_W_L $r2, 0, killed renamable $r8
    ST_W_L $r2, 4, $r0
    PseudoRET implicit $rets
...

# An early-clobber result is written before the source is read.
---
name: early_clobber
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2
    ; CHECK-LABEL: name: early_clobber
    ; CHECK-NOT: early-clobber renamable $r0 = LSL_RRR
    early-clobber renamable $r8 = LSL_RRR killed $r0, $r1, implicit-def dead $psr
    ST_W_L $r2, 0, killed renamable $r8
    PseudoRET implicit $rets
...
