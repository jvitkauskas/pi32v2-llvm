# Parallel issue: an instruction with a # twin and the short load or store after
# it go as one packet, unless A writes a register of B's.
# RUN: llc -mtriple=pi32v2 -mcpu=r3 -start-after=stack-frame-layout %s -o - | FileCheck %s
# RUN: llc -mtriple=pi32v2 -mcpu=r3 -start-after=stack-frame-layout %s -filetype=obj -o - \
# RUN:   | llvm-objdump -d - | FileCheck %s --check-prefix=OBJ
# RUN: llc -mtriple=pi32v2 -mcpu=r3 -start-after=stack-frame-layout %s -o - -pi32v2-parallel=false \
# RUN:   | FileCheck %s --check-prefix=OFF

# OBJ:      ac dc  r4 = r2 + r3  #
# OBJ-NEXT: 11 60  r1 = [r1+0]
# OFF-NOT:  #
---
name: pairs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r8

    ; an ALU form and an independent short load: one packet
    ; CHECK-LABEL: pairs:
    ; CHECK:      r4 = r2 + r3  #
    ; CHECK-NEXT: r1 = [r1+0]
    $r4 = ADD_RRR_L $r2, $r3, implicit-def dead $psr
    $r1 = LD_W_L $r1, 0 :: (load (s32))

    ; A reads the register B loads (B's load comes after): a packet
    ; CHECK-NEXT: r5 = r5 + r1  #
    ; CHECK-NEXT: r1 = [r0+4]
    $r5 = ADD_RRR_L $r5, $r1, implicit-def dead $psr
    $r1 = LD_W_L $r0, 4 :: (load (s32))

    ; B stores what A writes: B would store the old value
    ; CHECK-NEXT: r1 = r1 + r2{{$}}
    ; CHECK-NEXT: [r0+8] = r1
    $r1 = ADD_RRR_L $r1, $r2, implicit-def dead $psr
    ST_W_L $r0, 8, $r1 :: (store (s32))

    ; B loads into the register A writes: A's result would stay
    ; CHECK-NEXT: r2 = r3 + r4{{$}}
    ; CHECK-NEXT: r2 = [r0+12]
    $r2 = ADD_RRR_L $r3, $r4, implicit-def dead $psr
    $r2 = LD_W_L $r0, 12 :: (load (s32))

    ; A writes B's base
    ; CHECK-NEXT: r0 = r3 + r4{{$}}
    ; CHECK-NEXT: r1 = [r0+0]
    $r0 = ADD_RRR_L $r3, $r4, implicit-def dead $psr
    $r1 = LD_W_L $r0, 0 :: (load (s32))

    ; B on r8..r15 (a 32-bit form) is no parallel B
    ; CHECK-NEXT: r3 = r3 + r4{{$}}
    ; CHECK-NEXT: r1 = [r8+0]
    $r3 = ADD_RRR_L $r3, $r4, implicit-def dead $psr
    $r1 = LD_W_L $r8, 0 :: (load (s32))

    ; a 32-bit constant has no # form
    ; CHECK-NEXT: r3 = 305419896{{$}}
    ; CHECK-NEXT: r1 = [r0+0]
    $r3 = LI_U32 305419896
    $r1 = LD_W_L $r0, 0 :: (load (s32))

    ; a store to the stack after a float multiply
    ; CHECK-NEXT: r3 = r4 * r5 (f)  #
    ; CHECK-NEXT: [sp+4] = r2
    $r3 = MUL_F_RRR $r4, $r5
    ST_W_SP_L 4, $r2, implicit $sp :: (store (s32))
    PseudoRET implicit $r0
...
