# RUN: llc -mtriple=pi32v2 -run-pass=greedy,virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=pi32v2 -run-pass=greedy,virtregrewriter -pi32v2-low-hints=false -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=NO-LOW

--- |
  define void @low_address() optsize { ret void }
  define void @speed_address() { ret void }
...

# Two short loads pay for retaining the two-byte copy into a low register.
# The copy hint is still honored first if it is already low.
---
name: low_address
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r8
    ; CHECK-LABEL: name: low_address
    ; CHECK: renamable $r1 = COPY $r8
    ; CHECK-NEXT: renamable $r2 = LD_W_L renamable $r1, 0
    ; CHECK-NEXT: renamable $r1 = LD_W_L killed renamable $r1, 4
    ; NO-LOW-LABEL: name: low_address
    ; NO-LOW: renamable $r1 = LD_W_L renamable $r8, 0
    %0:gpr = COPY $r8
    %1:gpr = LD_W_L %0, 0
    %2:gpr = LD_W_L %0, 4
    %3:gpr = ADD_RRR_L %1, %2, implicit-def dead $psr
    ST_W_L $r0, 0, %3
    PseudoRET implicit $rets
...

# The same source remains high when the function is optimized for speed.
---
name: speed_address
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r8
    ; CHECK-LABEL: name: speed_address
    ; CHECK: renamable $r1 = LD_W_L renamable $r8, 0
    ; CHECK-NEXT: renamable $r2 = LD_W_L killed renamable $r8, 4
    %0:gpr = COPY $r8
    %1:gpr = LD_W_L %0, 0
    %2:gpr = LD_W_L %0, 4
    %3:gpr = ADD_RRR_L %1, %2, implicit-def dead $psr
    ST_W_L $r0, 0, %3
    PseudoRET implicit $rets
...
